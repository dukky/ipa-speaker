{
  "manifest_version": 3,
  "name": "IPA Speaker",
  "version": "0.1.0",
  "description": "Hear IPA pronunciations on Wikipedia and Wiktionary.",
  "permissions": ["offscreen", "contextMenus"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["*://*.wikipedia.org/*", "*://*.wiktionary.org/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Speak IPA" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
